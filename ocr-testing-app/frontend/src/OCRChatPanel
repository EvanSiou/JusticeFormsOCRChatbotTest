import { useMemo, useState } from 'react'

const SUGGESTED_PROMPTS = [
  'Summarize this document',
  'What fields are missing?',
  'Which OCR fields look uncertain?',
  'List all names and dates',
  'What is the form type?',
  'Convert extracted fields to JSON',
]

function getFieldList(documentData) {
  const fields = documentData?.extracted_fields

  if (Array.isArray(fields)) return fields

  if (fields && typeof fields === 'object') {
    return Object.entries(fields).map(([name, value]) => ({
      field_name: name,
      value,
    }))
  }

  return []
}

function getOcrText(documentData) {
  const ocrResults = documentData?.ocr_results

  if (!ocrResults) return ''

  if (typeof ocrResults === 'string') return ocrResults

  if (Array.isArray(ocrResults)) {
    return ocrResults
      .map((item) => item.text || item.full_text || '')
      .filter(Boolean)
      .join('\n')
  }

  if (Array.isArray(ocrResults.regions)) {
    return ocrResults.regions
      .map((region) => {
        if (region.full_text) return region.full_text
        if (region.text) return region.text
        if (Array.isArray(region.lines)) {
          return region.lines.map((line) => line.text || '').join('\n')
        }
        return ''
      })
      .filter(Boolean)
      .join('\n\n')
  }

  return ''
}

function buildMockResponse(message, documentData) {
  const lower = message.toLowerCase()
  const fields = getFieldList(documentData)
  const ocrText = getOcrText(documentData)

  const fieldCount = fields.length
  const pageCount = documentData?.page_count || 1
  const ocrAccuracy = documentData?.ocr_accuracy
  const classificationAccuracy = documentData?.classification_accuracy
  const judgeScore = documentData?.judge_overall_score

  if (lower.includes('summarize')) {
    return `Based on the OCR result, this appears to be a court-form document with ${pageCount} page(s). The system extracted ${fieldCount} field(s). ${
      ocrAccuracy !== undefined && ocrAccuracy !== null
        ? `The OCR accuracy score shown for this result is ${ocrAccuracy}.`
        : 'No OCR accuracy score is available in this result.'
    }

This is a mock assistant response. In the final version, this answer would be generated by the backend using the selected document's OCR text and extracted fields.`
  }

  if (lower.includes('missing')) {
    const emptyFields = fields.filter((field) => {
      const value = field.value ?? field.extracted_value ?? field.text ?? ''
      return value === '' || value === null || value === undefined
    })

    if (emptyFields.length === 0) {
      return `I do not see clearly empty extracted fields in the current result data. However, this mock assistant cannot fully verify whether fields are missing from the original document image.`
    }

    return `These fields appear to be empty or missing in the extracted data:\n\n${emptyFields
      .map((field) => `- ${field.field_name || field.name || 'Unnamed field'}`)
      .join('\n')}`
  }

  if (lower.includes('uncertain') || lower.includes('confidence')) {
    return `Fields that need review would normally be ranked by OCR confidence, classifier confidence, or judge score.

Current available scores:
- OCR accuracy: ${ocrAccuracy ?? 'not available'}
- Classification accuracy: ${classificationAccuracy ?? 'not available'}
- Judge overall score: ${judgeScore ?? 'not available'}

For the demo, I would flag handwritten names, dates, addresses, case numbers, and signature fields as the highest-priority items to verify against the original image.`
  }

  if (lower.includes('names') || lower.includes('dates')) {
    const likelyMatches = fields.filter((field) => {
      const name = String(field.field_name || field.name || '').toLowerCase()
      return (
        name.includes('name') ||
        name.includes('date') ||
        name.includes('plaintiff') ||
        name.includes('defendant') ||
        name.includes('petitioner') ||
        name.includes('respondent')
      )
    })

    if (likelyMatches.length === 0) {
      return `I could not identify name/date fields from the extracted field labels. In the final chatbot, the backend could scan the OCR text directly for names and dates.`
    }

    return `Likely name/date-related fields:\n\n${likelyMatches
      .map((field) => {
        const label = field.field_name || field.name || 'Unnamed field'
        const value = field.value ?? field.extracted_value ?? field.text ?? 'No value'
        return `- ${label}: ${value}`
      })
      .join('\n')}`
  }

  if (lower.includes('form type')) {
    const classification =
      documentData?.classification_results?.form_type ||
      documentData?.classification_results?.predicted_form_type ||
      documentData?.form_type ||
      'not available'

    return `The detected form type is: ${classification}

This is based on the classification data available in the selected OCR result.`
  }

  if (lower.includes('json')) {
    const json = fields.reduce((acc, field) => {
      const key = field.field_name || field.name || 'unnamed_field'
      acc[key] = field.value ?? field.extracted_value ?? field.text ?? ''
      return acc
    }, {})

    return `Here is a mock JSON version of the extracted fields:\n\n${JSON.stringify(json, null, 2)}`
  }

  return `I can help review this OCR result. Try asking me to summarize the document, identify missing fields, list names and dates, explain the form type, or convert extracted fields to JSON.

OCR text preview:
${ocrText ? ocrText.slice(0, 500) : 'No OCR text preview is available in the current document data.'}`
}

function OcrChatPanel({ testRunId, documentId, documentData }) {
  const [messages, setMessages] = useState([
    {
      role: 'assistant',
      content:
        'I am a mock document assistant. Ask me about the selected OCR result, extracted fields, form type, or confidence issues.',
    },
  ])
  const [input, setInput] = useState('')
  const [isSending, setIsSending] = useState(false)

  const canChat = Boolean(testRunId && documentId && documentData)

  const documentStats = useMemo(() => {
    const fields = getFieldList(documentData)

    return {
      fieldCount: fields.length,
      pageCount: documentData?.page_count || 1,
      ocrAccuracy: documentData?.ocr_accuracy,
    }
  }, [documentData])

  const sendMessage = async (messageText) => {
    const trimmed = messageText.trim()
    if (!trimmed || !canChat || isSending) return

    setInput('')
    setMessages((prev) => [...prev, { role: 'user', content: trimmed }])
    setIsSending(true)

    window.setTimeout(() => {
      const mockAnswer = buildMockResponse(trimmed, documentData)
      setMessages((prev) => [...prev, { role: 'assistant', content: mockAnswer }])
      setIsSending(false)
    }, 500)
  }

  return (
    <div className="bg-white rounded-lg shadow p-4">
      <div className="flex items-start justify-between gap-3 mb-3">
        <div>
          <h3 className="font-semibold">Document Assistant</h3>
          <p className="text-xs text-gray-500 mt-1">
            Mock chatbot connected to the selected OCR result.
          </p>
        </div>

        <span className="px-2 py-0.5 rounded text-xs bg-yellow-100 text-yellow-800">
          Mock Mode
        </span>
      </div>

      <div className="grid grid-cols-3 gap-2 mb-3 text-xs">
        <div className="rounded bg-gray-50 border p-2">
          <div className="text-gray-500">Pages</div>
          <div className="font-semibold">{documentStats.pageCount}</div>
        </div>
        <div className="rounded bg-gray-50 border p-2">
          <div className="text-gray-500">Fields</div>
          <div className="font-semibold">{documentStats.fieldCount}</div>
        </div>
        <div className="rounded bg-gray-50 border p-2">
          <div className="text-gray-500">OCR Score</div>
          <div className="font-semibold">
            {documentStats.ocrAccuracy ?? 'N/A'}
          </div>
        </div>
      </div>

      <div className="flex flex-wrap gap-2 mb-3">
        {SUGGESTED_PROMPTS.map((prompt) => (
          <button
            key={prompt}
            type="button"
            onClick={() => sendMessage(prompt)}
            disabled={!canChat || isSending}
            className="px-2.5 py-1 rounded-full text-xs bg-gray-100 text-gray-700 hover:bg-gray-200 disabled:opacity-50"
          >
            {prompt}
          </button>
        ))}
      </div>

      <div className="border rounded-lg bg-gray-50 p-3 h-72 overflow-y-auto space-y-3">
        {messages.map((message, index) => (
          <div
            key={`${message.role}-${index}`}
            className={`flex ${message.role === 'user' ? 'justify-end' : 'justify-start'}`}
          >
            <div
              className={`max-w-[85%] rounded-lg px-3 py-2 text-sm whitespace-pre-wrap ${
                message.role === 'user'
                  ? 'bg-blue-600 text-white'
                  : 'bg-white border text-gray-800'
              }`}
            >
              {message.content}
            </div>
          </div>
        ))}

        {isSending && (
          <div className="text-sm text-gray-500">
            Mock assistant is generating a response...
          </div>
        )}
      </div>

      <form
        className="mt-3 flex gap-2"
        onSubmit={(event) => {
          event.preventDefault()
          sendMessage(input)
        }}
      >
        <input
          value={input}
          onChange={(event) => setInput(event.target.value)}
          disabled={!canChat || isSending}
          placeholder="Ask about this OCR result..."
          className="flex-1 px-3 py-2 border rounded-md text-sm disabled:bg-gray-100"
        />

        <button
          type="submit"
          disabled={!input.trim() || !canChat || isSending}
          className="px-4 py-2 rounded-md text-sm font-medium bg-blue-600 text-white hover:bg-blue-700 disabled:opacity-50"
        >
          Send
        </button>
      </form>

      <p className="mt-2 text-[11px] text-gray-400">
        Demo assistant only. Final version should answer from backend-grounded OCR data and avoid legal advice.
      </p>
    </div>
  )
}

export default OcrChatPanel
