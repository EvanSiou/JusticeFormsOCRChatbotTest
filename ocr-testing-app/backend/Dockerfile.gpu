# GPU-enabled Dockerfile for VLM OCR engines (GOT-OCR, MinerU, TrOCR)
# Requires Cloud Run GPU support: --gpu 1 --gpu-type nvidia-l4 --cpu 4 --memory 16Gi

FROM nvidia/cuda:12.2.0-runtime-ubuntu22.04

WORKDIR /app

# Install Python and system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libgomp1 \
    gcc \
    g++ \
    tesseract-ocr \
    tesseract-ocr-eng \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies (GPU-enabled PyTorch)
COPY requirements-gpu.txt .
RUN pip install --no-cache-dir -r requirements-gpu.txt

# Pre-download model weights during build (avoids downloads at runtime)

# DocLayout-YOLO layout detection model
RUN python3 -c "from huggingface_hub import hf_hub_download; hf_hub_download(repo_id='juliozhao/DocLayout-YOLO-DocStructBench', filename='doclayout_yolo_docstructbench_imgsz1024.pt')"

# PaddleOCR models (PP-OCRv5 det + rec + textline orientation)
RUN python3 -c "import os; os.environ['PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK']='True'; from paddleocr import PaddleOCR; PaddleOCR(lang='en', use_doc_orientation_classify=False, use_doc_unwarping=False, use_textline_orientation=True, device='cpu', enable_mkldnn=False)"

# EasyOCR English models (detector + recognizer)
RUN python3 -c "import easyocr; easyocr.Reader(['en'], gpu=False, verbose=False)"

# Surya OCR models (Foundation + Recognition predictors)
RUN python3 -c "from surya.recognition import RecognitionPredictor, FoundationPredictor; fp = FoundationPredictor(); RecognitionPredictor(fp)"

# TrOCR handwritten model (~330MB)
RUN python3 -c "from transformers import TrOCRProcessor, VisionEncoderDecoderModel; TrOCRProcessor.from_pretrained('microsoft/trocr-base-handwritten'); VisionEncoderDecoderModel.from_pretrained('microsoft/trocr-base-handwritten')"

# GOT-OCR2.0 model (~580M params)
RUN python3 -c "from transformers import AutoProcessor, AutoModelForImageTextToText; AutoProcessor.from_pretrained('stepfun-ai/GOT-OCR-2.0-hf', use_fast=True); AutoModelForImageTextToText.from_pretrained('stepfun-ai/GOT-OCR-2.0-hf')"

# MinerU model (~1.2B params based on Qwen2VL)
RUN python3 -c "from transformers import AutoProcessor, Qwen2VLForConditionalGeneration; AutoProcessor.from_pretrained('opendatalab/MinerU2.5-2509-1.2B', use_fast=True); Qwen2VLForConditionalGeneration.from_pretrained('opendatalab/MinerU2.5-2509-1.2B')"

# Force offline mode so models load from cache without hitting network
ENV HF_HUB_OFFLINE=1
ENV TRANSFORMERS_OFFLINE=1
ENV PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True

# Ensure Python output is not buffered (critical for Cloud Run logging)
ENV PYTHONUNBUFFERED=1

# Copy application code
COPY . .

# Cloud Run uses PORT env var (defaults to 8080)
EXPOSE 8080

# Run with uvicorn on the PORT provided by Cloud Run
# Use exec so Python becomes PID 1 (proper signal handling + output flushing)
CMD ["sh", "-c", "exec python3 -m uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8080}"]
